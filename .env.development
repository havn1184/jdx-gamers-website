# Vite build-time env — nạp khi build với --mode development
# Không commit giá trị thật nhạy cảm vào đây nếu sau này có secret; hiện tại chỉ là URL/flag public.

# BE JGame thật — xem src/modules/JGameApp/shared/services/api/ApiConfig.ts
# Domain chuẩn môi trường Development (Docker Swarm 1-node, thử nghiệm với khách hàng): jgameapi.vtax.id.vn
# Muốn gọi thẳng IP nội bộ khi debug — dùng .env.development.local (gitignored), không sửa file này.
VITE_JGAME_API_URL=https://jgameapi.vtax.id.vn

VITE_API_TIMEOUT=30000
VITE_DEBUG=true

# Mật khẩu 4 tài khoản demo (nút đăng nhập nhanh ở màn Đăng nhập) — KHÔNG đặt giá trị thật ở
# đây (file này được commit lên git). Mỗi máy dev tự tạo file .env.development.local
# (gitignored) và set: VITE_JGAME_DEMO_PASSWORD=<mật khẩu demo>
VITE_JGAME_DEMO_PASSWORD=
