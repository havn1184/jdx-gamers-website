# Vite build-time env — nạp khi build với --mode production
# ⚠️ Vite bake cứng các giá trị này vào bundle JS lúc build — sửa xong PHẢI build lại image, không thể đổi lúc runtime.

# TODO: cập nhật khi BE JGame thật đã triển khai production
VITE_JGAME_API_URL=http://100.64.0.15:5013

# TODO: đổi false khi BE JGame thật sẵn sàng cho production
VITE_JGAME_USE_MOCK=true

VITE_API_TIMEOUT=30000
VITE_DEBUG=false

# Mật khẩu tài khoản demo — chỉ set khi thật sự cần bật đăng nhập demo trên môi trường này
# (bình thường nên để trống/tắt demo ở production). Set qua biến môi trường CI/CD lúc build,
# KHÔNG hardcode giá trị thật vào file này.
VITE_JGAME_DEMO_PASSWORD=
